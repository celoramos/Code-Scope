{
  "name": "code-scope",
  "displayName": "Code Scope",
  "description": "%description%",
  "version": "0.4.0",
  "publisher": "code-scope",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/celoramos/Code-Scope.git"
  },
  "homepage": "https://github.com/celoramos/Code-Scope#readme",
  "bugs": {
    "url": "https://github.com/celoramos/Code-Scope/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Education",
    "Visualization"
  ],
  "keywords": [
    "debug",
    "visualização",
    "ensino",
    "educação",
    "array",
    "pilha",
    "fila",
    "algoritmos",
    "iniciantes",
    "estrutura de dados",
    "java",
    "javascript",
    "typescript",
    "python"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onDebug"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeScope",
          "title": "Code Scope",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codeScope": [
        {
          "type": "webview",
          "id": "codeScope.panel",
          "name": "%view.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "codeScope.show",
        "title": "%command.show%",
        "category": "Code Scope"
      },
      {
        "command": "codeScope.clearHistory",
        "title": "%command.clearHistory%",
        "category": "Code Scope"
      }
    ],
    "configuration": {
      "title": "Code Scope",
      "properties": {
        "codeScope.beginnerMode": {
          "type": "boolean",
          "default": true,
          "description": "%config.beginnerMode%"
        },
        "codeScope.animationSpeed": {
          "type": "string",
          "enum": [
            "lenta",
            "normal",
            "rapida",
            "desligada"
          ],
          "enumDescriptions": [
            "%config.animationSpeed.slow%",
            "%config.animationSpeed.normal%",
            "%config.animationSpeed.fast%",
            "%config.animationSpeed.off%"
          ],
          "default": "normal",
          "description": "%config.animationSpeed%",
          "enumItemLabels": [
            "%config.animationSpeed.slow.label%",
            "%config.animationSpeed.normal.label%",
            "%config.animationSpeed.fast.label%",
            "%config.animationSpeed.off.label%"
          ]
        },
        "codeScope.maxElements": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 500,
          "description": "%config.maxElements%"
        },
        "codeScope.valueNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "temp",
            "tmp",
            "aux",
            "alvo",
            "target",
            "valor",
            "value",
            "chave",
            "key",
            "soma",
            "sum",
            "total",
            "n",
            "len",
            "tamanho",
            "size",
            "count",
            "contador"
          ],
          "description": "%config.valueNames%"
        },
        "codeScope.revealOnDebug": {
          "type": "boolean",
          "default": true,
          "description": "%config.revealOnDebug%"
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit && tsc --noEmit --allowJs --checkJs --lib dom,es2022 --target es2022 --skipLibCheck --types node media/main.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "test": "mocha",
    "test:integration": "npm run compile && node esbuild.test.js && tsx test/integration/runTest.ts",
    "vscode:prepublish": "npm run package",
    "vsix": "vsce package --out code-scope.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "mocha": "^11.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
