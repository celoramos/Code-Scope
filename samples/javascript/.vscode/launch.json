{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "name": "Arquivo aberto",
      "request": "launch",
      "program": "${file}",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "stopOnEntry": true
    },
    {
      "type": "chrome",
      "name": "Navegador (Chrome)",
      "request": "launch",
      "file": "${workspaceFolder}/navegador/index.html"
    }
  ]
}
